# ============================================================
# K-CONNECT — .gitignore
# ============================================================

# ── Environment variables ────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Node.js / Frontend ──────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
*.tsbuildinfo

# ── Python / Backend ────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Virtual environments
venv/
.venv/
env/
ENV/
.python-version

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/

# Test / coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover

# Type checkers
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ── Alembic ─────────────────────────────────────────────────
# Keep versions tracked; ignore only local temporary files
backend/alembic/__pycache__/

# ── Logs ────────────────────────────────────────────────────
*.log
logs/
*.pid

# ── OS / Editor ─────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# VS Code (keep workspace settings but ignore personal)
.vscode/settings.json
.vscode/launch.json
!.vscode/extensions.json

# JetBrains
.idea/

# ── IIS / Windows ───────────────────────────────────────────
# Don't ignore iis/web.config — it's tracked intentionally

# ── Misc ────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
Thumbs.db
