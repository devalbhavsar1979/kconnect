# ============================================================
# K-CONNECT Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# Application
APP_NAME=K-CONNECT
ENVIRONMENT=development

# Database
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://kconnect_user:CHANGE_PASSWORD@localhost:5432/kconnect_db

# JWT — generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated list of allowed origins
# Development:
CORS_ORIGINS=http://localhost:5173
# Production example:
# CORS_ORIGINS=https://kconnect.yourdomain.com
