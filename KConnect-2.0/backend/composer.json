{
  "name": "kconnect/api",
  "type": "project",
  "description": "K-CONNECT migration foundation API",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-fileinfo": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "firebase/php-jwt": "^7.2",
    "laravel/framework": "^13.0"
  },
  "require-dev": {"phpunit/phpunit": "^12.0"},
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"], "test": "phpunit"},
  "config": {"optimize-autoloader": true, "sort-packages": true, "platform": {"php": "8.4.26"}, "allow-plugins": {}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
